# -- API Keys --
HELIUS_API_KEY="YOUR_HELIUS_API_KEY"
BITQUERY_API_KEY="YOUR_BITQUERY_API_KEY"

# -- Solana Configuration --
RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY"

# -- Multi-RPC Configuration (Optional - for faster detection) --
ADDITIONAL_RPC_URLS=""

# -- Detection Mode --
# Options: "multi-rpc" (default, fastest free), "hybrid", "webhook", "onlogs"
DETECTION_MODE="multi-rpc"

# -- DEX Toggle Configuration --
# Set to "true" or "false" to enable/disable each DEX
# If both are false, defaults to Meteora only
METEORA_ENABLED="true"
RAYDIUM_ENABLED="true"

# -- DEX Monitoring Configuration --
# Which DEXes to monitor for new pools (comma-separated)
# Options: raydium, meteora-dlmm, meteora-damm-v2, meteora-damm-v1, meteora-dbc
MONITORED_DEXES="raydium,meteora-dlmm,meteora-damm-v2"

# -- Webhook Configuration (for hybrid/webhook mode) --
WEBHOOK_ENABLED="false"
WEBHOOK_URL=""
WEBHOOK_PATH="/webhook"

# -- Wallet Configuration --
PRIVATE_KEY="YOUR_WALLET_PRIVATE_KEY"

# -- Portfolio Management --
MAX_PORTFOLIO_SIZE="4"
MIN_SOL_BALANCE="0.05"

# -- Token Vetting Strategy --
MIN_LIQUIDITY_USD="1000"
MAX_LIQUIDITY_USD="100000"
MIN_MARKET_CAP_USD="5000"
MAX_HOLDER_CONCENTRATION_PERCENT="25"
MAX_DEV_WALLET_COUNT="5"
MAX_INITIAL_DEV_SELL_PERCENT="10"

# -- Anti-Rug Protection (Stricter Settings) --
# Minimum percentage of LP tokens that must be locked/burned (0-100)
MIN_LP_LOCKED_PERCENT="0"
# Minimum pool age in seconds before buying (helps avoid instant rugs)
MIN_POOL_AGE_SECONDS="30"
# Maximum percentage a single top holder can own (excluding LP)
MAX_TOP_HOLDER_PERCENT="30"
# Require token to be verified on RugCheck (true/false)
REQUIRE_VERIFIED_TOKEN="false"

# -- NEW Anti-Rug Checks --
# Maximum a SINGLE holder can own (catches whale dominance) - default 50%
MAX_SINGLE_HOLDER_PERCENT="50"
# Minimum LP providers count (0 = disabled, new coins start with 0)
MIN_LP_PROVIDERS="0"
# Minimum liquidity age in seconds (5s = wait for pool to stabilize)
MIN_LIQUIDITY_AGE_SECONDS="5"
# Maximum instructions in creation TX (bundled rugs often have many)
MAX_BUNDLED_TX_INSTRUCTIONS="10"
# Check creator's past tokens for rugs (true/false)
CHECK_CREATOR_HISTORY="true"
# Maximum rugged/dead tokens creator can have (0 = no tolerance)
MAX_CREATOR_RUGGED_TOKENS="0"
# Maximum token age in minutes to consider (skip old coins)
MAX_TOKEN_AGE_MINUTES="4"

# -- Trade Sizing Strategy (SOL per risk level) --
TRADE_AMOUNT_SOL_GOOD="0.01"
TRADE_AMOUNT_SOL_WARNING="0.007"
TRADE_AMOUNT_SOL_DANGER="0.002"

# -- Slippage Configuration --
SLIPPAGE_BPS="5000"
JUPITER_PRE_QUOTE_DELAY_MS="0"

# -- Risk Management Strategy --
TRAILING_STOP_LOSS_PERCENT="5"
STALE_DANGER_COIN_MINUTES="4"
DEEP_LOSS_PERCENT_DANGER="-50"
GLOBAL_STOP_LOSS_USD="-100"

# -- Real-time Price Monitoring --
REALTIME_PRICE_POLL_INTERVAL_MS="2000"

# -- Take Profit Strategy (DANGER RISK) --
TAKE_PROFIT_PERCENT_DANGER="10"

# -- Take Profit Strategy (WARNING RISK) --
TAKE_PROFIT_PERCENT_WARNING="20"

# -- Take Profit Strategy (GOOD RISK - Tiered) --
GOOD_TP_1_PERCENT="20"
GOOD_TP_1_SELL_PERCENT="10"
GOOD_TP_2_PERCENT="30"
GOOD_TP_2_SELL_PERCENT="40"
GOOD_TP_3_PERCENT="50"
GOOD_TP_3_SELL_PERCENT="100"

# -- Token Account Management --
CLOSE_ATA_DELAY_MS="5000"

# -- Telegram Notifications --
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# -- Server Configuration --
PORT="3000"
